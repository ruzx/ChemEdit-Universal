{
  "name": "chemedit-new",
  "version": "1.1.2",
  "description": "Lightweight chemical structure editor plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "build:offline": "tsc --noEmit -p tsconfig.offline.json && node esbuild.config.mjs production",
    "demo": "esbuild test/harness.ts --bundle --format=iife --loader:.css=text --outfile=test/harness.js",
    "test": "esbuild test/engine.test.ts --bundle --platform=node --outfile=test/.engine.test.js && node test/.engine.test.js"
  },
  "keywords": [
    "obsidian",
    "chemistry",
    "smiles",
    "molfile",
    "chemdraw"
  ],
  "author": "Ruzal Sitdikov",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.10.2",
    "esbuild": "0.24.0",
    "obsidian": "1.7.2",
    "typescript": "5.6.3"
  }
}
